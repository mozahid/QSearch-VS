<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QSearch.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QSearch"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:QSearch}"
        Route="QSearch" />
    <ShellContent
        Title="Surah"
        ContentTemplate="{DataTemplate local:RSurah}"
        Route="RSurah" />
</Shell>

