<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QSearch"
             x:Class="QSearch.RSurah"
             NavigationPage.HasBackButton="False"
             Title="Recite Surah">
    <ContentPage.ToolbarItems>
      <ToolbarItem Clicked="ToolbarItem_Clicked" Text="More">
        <ToolbarItem.IconImageSource>
          <FontImageSource
            FontFamily="MaterialIconsOutlined-Regular"
            Glyph="&#xe8b6;"
            Color="LightBlue"
            Size="32"
              />
        </ToolbarItem.IconImageSource>
      </ToolbarItem>
      </ContentPage.ToolbarItems>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <FlexLayout 
                HorizontalOptions="Center"
                Grid.Row="0">
                <ImageButton x:Name="btnLine" BackgroundColor="PaleGoldenrod" Clicked="btnLine_Clicked">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Color="Black"
                            Glyph="&#xe8ee;"
                            Size="28" />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="bmSurah"
                        BackgroundColor="LightGoldenrodYellow"
                        ToolTipProperties.Text="Bookmark this surah" Clicked="bmSurah_Clicked">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#xe866;" Color="Black" FontFamily="MaterialIconsOutlined-Regular" Size="28">
                        </FontImageSource>
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                    <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                 </ImageButton>
                <ImageButton x:Name="openBM"
                         BackgroundColor="LightSkyBlue"
                         ToolTipProperties.Text="Open bookmarks" Clicked="openBM_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe98b;"
                            Size="28"
                            />                        
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                    <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="showTranslation"
                    BackgroundColor="LightGreen"
                    ToolTipProperties.Text="Show translation" Clicked="showTranslation_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIconsOutlined-Regular"
                                Color="Black"
                                Glyph="&#xe894;"
                                Size="28"
                            />                         
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="btnFont" BackgroundColor="OliveDrab" Clicked="btnFont_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe167;"
                            Size="28"
                            />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>                
                <ImageButton x:Name="btnBack" BackgroundColor="LightSkyBlue" Clicked="btnBack_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe5e0;"
                            Size="28"
                            />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>  
                <ImageButton x:Name="btnForward" BackgroundColor="LightSkyBlue" Clicked="btnForward_Clicked">
                <ImageButton.Source>
                        <FontImageSource
                        FontFamily="MaterialIconsOutlined-Regular"
                        Glyph="&#xe5e1;"
                        Size="28"
                        />
                </ImageButton.Source>
                <ImageButton.Shadow>
                    <Shadow Brush="Gray"
                        Offset="20,20"
                        Radius="40"
                        Opacity="0.8" />
                </ImageButton.Shadow>
            </ImageButton>  
            </FlexLayout>
            <Grid 
                Grid.Row="1"
                HorizontalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    HorizontalOptions="Fill"
                    Grid.Row="0"
                    Grid.RowSpan="3" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="3">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                            <GradientStop Color="GhostWhite" Offset="0.0" />
                            <GradientStop Color="LightGreen" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,0"
                            Radius="20"
                            Opacity="0.8" />
                    </Border.Shadow>    
                </Border>
                <Label
                    FontFamily="Tahoma"
                    FontSize="Small"
                    TextColor="SlateBlue"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="5,10,0,0">
                <Label.FormattedText>     
                    <FormattedString>
                        <Span Text="{Binding para_name}" FontAttributes="Bold" />
                        <Span Text="(" />
                        <Span Text="{Binding para_number}" FontAttributes="Bold" />
                        <Span Text=")" />
                    </FormattedString>
                </Label.FormattedText>
                </Label>
                <Label
                    FontFamily="NotoArabic"
                    FontSize="Small"
                    TextColor="SlateBlue"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="0,10,5,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding class_arabic}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label
                    FontFamily="NotoArabic"
                    TextColor="Goldenrod"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    >
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding chapter_name_arabic}" FontSize="Title" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                 <Label
                    FontFamily="Tahoma"
                    HorizontalOptions="Start"
                    Grid.Row="2"
                    Grid.Column="0"
                    Padding="5,0,5,5">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Chapter #: " FontSize="Micro" />
                                <Span Text="{Binding chapter_number}" FontSize="Small" FontAttributes="Bold" TextColor="OrangeRed" />
                            </FormattedString>
                        </Label.FormattedText>
                </Label>               
                <Label
                    FontFamily="Tahoma"
                    HorizontalOptions="End"
                    Grid.Row="2"
                    Grid.Column="2"
                    Padding="0,0,5,5">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Total lines - " FontSize="Micro" />
                                <Span Text="{Binding verse_count}" FontSize="Small" FontAttributes="Bold" TextColor="OrangeRed" />
                            </FormattedString>
                        </Label.FormattedText>
                </Label>
        </Grid>
        <Grid 
            IsVisible="{Binding IsBusy}"  
            BackgroundColor="Transparent"
            Margin="0,3,0,0"
            Grid.Row="2">
            <ActivityIndicator x:Name="progInd"
                    IsRunning="{Binding IsBusy}"
                    Color="Blue"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                />

            <CollectionView
                x:Name="lstView"
                Margin="3"
                VerticalScrollBarVisibility="Default" >

            </CollectionView>
        </Grid>                     
    </Grid>
</ContentPage>
