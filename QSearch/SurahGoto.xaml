<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QSearch.SurahGoto"
             xmlns:local="clr-namespace:QSearch"
             NavigationPage.HasBackButton="False"
             Title="Surah Goto">
 <ContentPage.ToolbarItems>
      <ToolbarItem Clicked="ToolbarItem_Clicked" Text="More">
        <ToolbarItem.IconImageSource>
          <FontImageSource
            FontFamily="MaterialIconsOutlined-Regular"
            Glyph="&#xe8b6;"
            Color="LightBlue"
            Size="32"
              />
        </ToolbarItem.IconImageSource>
      </ToolbarItem>
      </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
            <FlexLayout Grid.Row="0" HorizontalOptions="Center">
                <ImageButton x:Name="btnLine" BackgroundColor="PaleGoldenrod" Clicked="btnLine_Clicked">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Color="Black"
                            Glyph="&#xe8ee;"
                            Size="28" />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="openBM"
                         BackgroundColor="LightSkyBlue"
                         ToolTipProperties.Text="Open bookmarks" Clicked="openBM_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe98b;"
                            Size="28"
                            />                        
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                    <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="showTranslation"
                    BackgroundColor="LightGreen"
                    ToolTipProperties.Text="Show translation" Clicked="showTranslation_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIconsOutlined-Regular"
                                Color="Black"
                                Glyph="&#xe894;"
                                Size="28"
                            />                         
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="btnFont" BackgroundColor="OliveDrab" Clicked="btnFont_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe167;"
                            Size="28"
                            />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
            </FlexLayout>
            <Grid Grid.Row="1" Background="Transparent">
                <ActivityIndicator x:Name="progInd"
                        IsRunning="{Binding IsBusy}"
                        Color="Blue"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                    <CollectionView
                        x:Name="lstView"            
                        Margin="3"
                        IsGrouped="True"
                        RemainingItemsThreshold="2"
                        VerticalScrollBarVisibility="Always" >
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate>
                                <Grid HorizontalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="*" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border
                                    HorizontalOptions="Fill"
                                    Grid.Row="0"
                                    Grid.RowSpan="3" 
                                    Grid.Column="0" 
                                    Grid.ColumnSpan="3">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                            <GradientStop Color="GhostWhite" Offset="0.0" />
                                            <GradientStop Color="LightGreen" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.Shadow>
                                        <Shadow Brush="Gray"
                                            Offset="20,0"
                                            Radius="20"
                                            Opacity="0.8" />
                                    </Border.Shadow>    
                                </Border>
                                <Label
                                    FontFamily="Tahoma"
                                    FontSize="Small"
                                    TextColor="SlateBlue"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="5,10,0,0">
                                 <Label.FormattedText>     
                                    <FormattedString>
                                        <Span Text="{Binding para_name}" FontAttributes="Bold" />
                                        <Span Text="(" />
                                        <Span Text="{Binding para_no}" FontAttributes="Bold"  />
                                        <Span Text=")" />
                                    </FormattedString>
                                 </Label.FormattedText>
                                 </Label>
                                <Label
                                     FontFamily="NotoArabic"
                                    FontSize="Small"
                                    TextColor="SlateBlue"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Padding="0,10,5,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding chapter_class}" FontAttributes="Bold"></Span>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    FontFamily="NotoArabic"
                                    TextColor="Goldenrod"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    >
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding chapter_name}" FontSize="Large" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                        HorizontalOptions="Start"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Padding="10,0,0,0"
                                        >
                                        <Label.FormattedText>
                                            <FormattedString>
                                                    <Span Text="Chapter # - " FontSize="Micro" />
                                                    <Span Text="{Binding chapter_number}" TextColor="SlateBlue" FontSize="Small" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                </Label>                                                                      
                                <Label
                                    HorizontalOptions="End"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Padding="0,0,10,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                                <Span Text="Total lines - " FontSize="Micro" />
                                                <Span Text="{Binding total_verses}" TextColor="SlateBlue" FontSize="Small" FontAttributes="Bold"  />
                                         </FormattedString>
                                    </Label.FormattedText>
                                </Label>                            
                                </Grid>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                                                <CollectionView.ItemTemplate>
