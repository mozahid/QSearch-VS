<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QSearch.SurahGoto"
             xmlns:local="clr-namespace:QSearch"
             NavigationPage.HasBackButton="False"
             Title="Surah Goto">
 <ContentPage.ToolbarItems>
      <ToolbarItem Clicked="ToolbarItem_Clicked" Text="More">
        <ToolbarItem.IconImageSource>
          <FontImageSource
            FontFamily="MaterialIconsOutlined-Regular"
            Glyph="&#xe8b6;"
            Color="LightBlue"
            Size="32"
              />
        </ToolbarItem.IconImageSource>
      </ToolbarItem>
      </ContentPage.ToolbarItems>
    <VerticalStackLayout Spacing="5">
            <FlexLayout HorizontalOptions="Center">
                <ImageButton x:Name="openBM"
                         BackgroundColor="LightSkyBlue"
                         ToolTipProperties.Text="Open bookmarks" Clicked="openBM_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe98b;"
                            Size="28"
                            />                        
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                    <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="showTranslation"
                    BackgroundColor="LightGreen"
                    ToolTipProperties.Text="Show translation" Clicked="showTranslation_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                                FontFamily="MaterialIconsOutlined-Regular"
                                Color="Black"
                                Glyph="&#xe894;"
                                Size="28"
                            />                         
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>
                <ImageButton x:Name="btnFont" BackgroundColor="OliveDrab" Clicked="btnFont_Clicked">
                    <ImageButton.Source>
                            <FontImageSource
                            FontFamily="MaterialIconsOutlined-Regular"
                            Glyph="&#xe167;"
                            Size="28"
                            />
                    </ImageButton.Source>
                    <ImageButton.Shadow>
                        <Shadow Brush="Gray"
                            Offset="20,20"
                            Radius="40"
                            Opacity="0.8" />
                    </ImageButton.Shadow>
                </ImageButton>       
            </FlexLayout>
            <Grid IsVisible="{Binding IsBusy}"  BackgroundColor="Transparent">
