                                    </Border.StrokeShape>
                                    <Grid RowSpacing="3" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <local:VerseTextView Grid.Row="0" IsVisible="{Binding showLine[0]}" FontName="{Binding font}" FontSize="32" HorizontalOptions="Fill" FlowDirection="RightToLeft" VerticalOptions="Start" VerseImage="quranic_border_4_raw.png" VerseText="{Binding verse_arabic_lines[0]}" VerseNumber="{Binding verse_number[0]}" Ruku="{Binding ruku_lines[0]}" Sujood="{Binding sujood_lines[0]}" />
