                            <DataTemplate>
                            <Grid HorizontalOptions="Fill"
                                  >
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="*" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border
                                    HorizontalOptions="Fill"
                                    Grid.Row="0"
                                    Grid.RowSpan="3" 
                                    Grid.Column="0" 
                                    Grid.ColumnSpan="3">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                            <GradientStop Color="GhostWhite" Offset="0.0" />
                                            <GradientStop Color="LightGreen" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.Shadow>
                                        <Shadow Brush="Gray"
                                            Offset="20,0"
                                            Radius="20"
                                            Opacity="0.8" />
                                    </Border.Shadow>    
                                </Border>
                                <!-- <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Grid.RowSpan="3"
                                        Opacity="0.8"
                                        Source="qs_hdr4.png"
                                        Aspect="Fill"
                                        HeightRequest="90" /> -->
                                <Label
                                    FontFamily="Tahoma"
                                    FontSize="Small"
                                    TextColor="SlateBlue"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="5,10,0,0">
                                 <Label.FormattedText>     
                                    <FormattedString>
                                        <Span Text="{Binding para_name}" FontAttributes="Bold" />
                                        <Span Text="(" />
                                        <Span Text="{Binding para_no}" FontAttributes="Bold"  />
                                        <Span Text=")" />
                                    </FormattedString>
                                 </Label.FormattedText>
                                 </Label>
                                <Label
                                     FontFamily="NotoArabic"
                                    FontSize="Small"
                                    TextColor="SlateBlue"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Padding="0,10,5,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding chapter_class}" FontAttributes="Bold"></Span>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
