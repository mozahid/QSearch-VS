                                        HorizontalOptions="Start"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Padding="10,0,0,0"
                                        >
                                        <Label.FormattedText>
                                            <FormattedString>
                                                    <Span Text="Chapter # - " FontSize="Micro" />
                                                    <Span Text="{Binding chapter_number}" TextColor="SlateBlue" FontSize="Small" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                </Label>                                                                      
