<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QSearch.AsmaHusana"
             Title="AsmaHusana">
    <VerticalStackLayout>
            <Grid x:Name="myGrid" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CollectionView -->
                <CollectionView x:Name="myCollectionView"
                                ItemsSource="{Binding MyItems}"
                                SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                        SnapPointsType="MandatorySingle"
                                        SnapPointsAlignment="Center" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />  
                                </Grid.ColumnDefinitions>
                            <Label  Text="{Binding number}" 
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    BackgroundColor="Blue"
                                    TextColor="White"
                                    Margin="5,0,0,0"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    FontSize="14"
                                    Padding="5"
                                    Grid.Row="0" />
                            <Label  Text="{Binding name}" 
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="Goldenrod"
                                    FontFamily="{Binding font_arabic}"
                                    FontAttributes="Bold"
                                    HeightRequest="{Binding size_arabic}"
                                    WidthRequest="{Binding size_arabic}"
                                    FontSize="150"
                                    Padding="5"
                                    Grid.Row="1">
                                    <Label.Shadow>
                                            <Shadow Brush="LightGray"
                                                    Offset="5,5"
                                                    Radius="5"
                                                    Opacity="0.5" />
                                        </Label.Shadow>
                            </Label>
                            <Label  Text="{Binding english_meaning}" 
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="End"
                                    FontAttributes="Bold"
                                    Padding="5"
                                    FontSize="16"
                                    Grid.Row="2" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Navigation Buttons -->
                <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="10">
                    <Button Text="&lt;" FontAttributes="Bold" FontSize="16" BackgroundColor="Teal" Clicked="OnBackClicked" />
                    <Button Text="&gt;" FontAttributes="Bold" FontSize="16" BackgroundColor="Teal" Clicked="OnForwardClicked" />
                </HorizontalStackLayout>
            </Grid>

    </VerticalStackLayout>
</ContentPage>