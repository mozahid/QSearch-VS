	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.9.4" />
	  <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.3.3" />
	</ItemGroup>
	<ItemGroup>
	  <MauiImage Remove="Resources\Images\tick_mark.svg" />
