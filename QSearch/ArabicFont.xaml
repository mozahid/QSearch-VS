<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QSearch.ArabicFont"
             BackgroundColor="#aa000000"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.ModalPresentationStyle="OverFullScreen"
             NavigationPage.HasBackButton="False"
             Title="Arabic Font">
    <ContentPage.Resources>
        <ControlTemplate x:Key="ArabicFontRadioTemplate">
            <Border Background="White"
                    Stroke="Silver"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10,4">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CheckedStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="LightSkyBlue" />
                                    <Setter Property="Stroke" Value="DeepSkyBlue" />
                                    <Setter TargetName="checkDot" Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked">
                                <VisualState.Setters>
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Stroke" Value="Silver" />
                                    <Setter TargetName="checkDot" Property="Opacity" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="24,*"
                      ColumnSpacing="10">
                    <Grid WidthRequest="20"
                          HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <Ellipse Stroke="DeepSkyBlue"
                                 StrokeThickness="2"
                                 Fill="White" />
                        <Ellipse x:Name="checkDot"
                                 WidthRequest="10"
                                 HeightRequest="10"
                                 Fill="DeepSkyBlue"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Opacity="0" />
                    </Grid>
                    <ContentPresenter Grid.Column="1"
                                      VerticalOptions="Center" />
                </Grid>
            </Border>
        </ControlTemplate>
        <Style TargetType="RadioButton">
            <Setter Property="ControlTemplate"
                    Value="{StaticResource ArabicFontRadioTemplate}" />
        </Style>
    </ContentPage.Resources>
        <VerticalStackLayout BackgroundColor="White" HeightRequest="550" >
                    <Label 
                        Text="Arabic Fonts"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Margin="0,20,0,10" />
                    <Border Stroke="Gray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12,12,12,12"
                            Margin="10,10"
                            Padding="5,5"
                            BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="LightGray"
                                    Offset="0,4"
                                    Radius="10"
                                    Opacity="0.45" />
                        </Border.Shadow>
                        <Grid RowSpacing="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="radNaksh"
                                         Value="1"
                                         GroupName="Arabic"
                                         IsChecked="True"
                                         Grid.Row="0"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="NotoArabic"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="radLateef"
                                         Value="2"
                                         GroupName="Arabic"
                                         Grid.Row="1"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="Lateef"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="radAlQalam"
                                         Value="3"
                                         GroupName="Arabic"
                                         Grid.Row="2"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="AlQalam"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="radIndoPak"
                                         Value="4"
                                         GroupName="Arabic"
                                         Grid.Row="3"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="IndoPak"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="radMeQuran"
                                         Value="5"
                                         GroupName="Arabic"
                                         Grid.Row="4"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="MeQuran"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton x:Name="radHafsQuran"
                                         Value="6"
                                         GroupName="Arabic"
                                         Grid.Row="5"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         Padding="10,3"
                                         CheckedChanged="radFont_CheckedChanged">
                                <RadioButton.Content>
                                    <Label Text="قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ"
                                           FontFamily="Uthmani"
                                           FontSize="Title"
                                           VerticalOptions="Center" />
                                </RadioButton.Content>
                            </RadioButton>
                        </Grid>
                    </Border>
                <FlexLayout HorizontalOptions="Center">
                        <ImageButton x:Name="btnSelect" BackgroundColor="Teal"  Clicked="btnSelect_Clicked">
                            <ImageButton.Source>
                                <FontImageSource
                                    FontFamily="MaterialIconsOutlined-Regular"
                                    Glyph="&#xe5ca;"
                                    Color="White"
                                    Size="16"                                   
                                />
                            </ImageButton.Source>
                            <ImageButton.Shadow>
                                    <Shadow Brush="Gray"
                                        Offset="20,20"
                                        Radius="40"
                                        Opacity="0.8" />
                            </ImageButton.Shadow>
                        </ImageButton>
                        <Label Text="    " />
                        <ImageButton x:Name="btnCancel"  BackgroundColor="LightSalmon" Clicked="btnCancel_Clicked">
                            <ImageButton.Source>
                                <FontImageSource
                                    FontFamily="MaterialIconsOutlined-Regular"
                                    Glyph="&#xe5cd;"
                                    Color="Black"
                                    Size="16"                                   
                                />
                            </ImageButton.Source>
                            <ImageButton.Shadow>
                                    <Shadow Brush="Gray"
                                        Offset="20,20"
                                        Radius="40"
                                        Opacity="0.8" />
                            </ImageButton.Shadow>
                        </ImageButton>
                </FlexLayout>
        </VerticalStackLayout>
</ContentPage>
