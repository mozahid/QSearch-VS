                                            <FormattedString>
                                                <Span Text="{Binding chapter_name}" FontSize="Title" FontAttributes="Bold" />
                                                <Span Text="("  FontSize="Small"  />
                                                <Span Text="{Binding total_verses}"   FontSize="Small"  />
                                                <Span Text=")"  FontSize="Small"  />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>                                   
                                    <Label
                                        FontFamily="Tahoma"
                                        HorizontalOptions="Start"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Padding="10,0,0,5"
