<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QSearch.RPara"
             xmlns:local="clr-namespace:QSearch"
             NavigationPage.HasBackButton="False"
             Title="Recite Para">
    <ContentPage.ToolbarItems>
      <ToolbarItem Clicked="ToolbarItem_Clicked" Text="More">
        <ToolbarItem.IconImageSource>
          <FontImageSource
            FontFamily="MaterialIconsOutlined-Regular"
            Glyph="&#xe8b6;"
            Color="LightBlue"
            Size="32"
              />
        </ToolbarItem.IconImageSource>
      </ToolbarItem>
      </ContentPage.ToolbarItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                 <FlexLayout 
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Grid.Row="0">
                        <ImageButton x:Name="showTranslation"
                            BackgroundColor="LightGreen"
                            ToolTipProperties.Text="Show translation" Clicked="showTranslation_Clicked">
                            <ImageButton.Source>
                                <FontImageSource
                                    FontFamily="MaterialIconsOutlined-Regular"
                                    Color="Black"
                                    Glyph="&#xe894;"
                                    Size="28"
                                /> 
                            </ImageButton.Source>
                            <ImageButton.Shadow>
                                <Shadow Brush="Gray"
                                    Offset="20,20"
                                    Radius="40"
                                    Opacity="0.8" />
                            </ImageButton.Shadow>
                        </ImageButton>
                        <ImageButton x:Name="btnFont" BackgroundColor="OliveDrab" Clicked="btnFont_Clicked">
                            <ImageButton.Source>
                                    <FontImageSource
                                    FontFamily="MaterialIconsOutlined-Regular"
                                    Glyph="&#xe167;"
                                    Size="28"
                                    />
                            </ImageButton.Source>
                            <ImageButton.Shadow>
                                <Shadow Brush="Gray"
                                    Offset="20,20"
                                    Radius="40"
                                    Opacity="0.8" />
                            </ImageButton.Shadow>
                        </ImageButton>
                        <ImageButton x:Name="btnBack" BackgroundColor="LightSkyBlue" Clicked="btnBack_Clicked">
                                <ImageButton.Source>
                                        <FontImageSource
                                        FontFamily="MaterialIconsOutlined-Regular"
                                        Glyph="&#xe5e0;"
                                        Size="28"
                                        />
                                </ImageButton.Source>
                                <ImageButton.Shadow>
                                    <Shadow Brush="Gray"
                                        Offset="20,20"
                                        Radius="40"
                                        Opacity="0.8" />
                                </ImageButton.Shadow>
                            </ImageButton>  
                            <ImageButton x:Name="btnForward" BackgroundColor="LightSkyBlue" Clicked="btnForward_Clicked">
                            <ImageButton.Source>
                                    <FontImageSource
                                    FontFamily="MaterialIconsOutlined-Regular"
                                    Glyph="&#xe5e1;"
                                    Size="28"
                                    />
                            </ImageButton.Source>
                            <ImageButton.Shadow>
                                <Shadow Brush="Gray"
                                    Offset="20,20"
                                    Radius="40"
                                    Opacity="0.8" />
                            </ImageButton.Shadow>
                        </ImageButton>  
                    </FlexLayout>
                    <Grid IsVisible="{Binding IsBusy}" 
                        BackgroundColor="Transparent"
                        Grid.Row="1">
                        <ActivityIndicator x:Name="progInd"
                            IsRunning="{Binding IsBusy}"
                            Color="Blue"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                        />
